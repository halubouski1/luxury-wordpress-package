{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/apartments/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": true },
  "login": true,
  "steps": [
    { "step": "setSiteOptions", "options": { "blogname": "Luxury Apart Hotel (demo)", "permalink_structure": "/%postname%/" } },
    { "step": "installPlugin", "pluginData": { "resource": "url", "url": "https://raw.githubusercontent.com/halubouski1/luxury-wordpress-package/main/catalog-v1.1/luxury-editorial-plugin.zip" } },
    { "step": "installTheme", "themeData": { "resource": "url", "url": "https://raw.githubusercontent.com/halubouski1/luxury-wordpress-package/main/catalog-v1.1/luxury-apart-hotel-theme.zip" } },
    { "step": "runPHP", "code": "<?php require '/wordpress/wp-load.php'; wp_set_current_user(1); lux_import_starter(true); lux_import_catalog(); flush_rewrite_rules();" }
  ]
}
