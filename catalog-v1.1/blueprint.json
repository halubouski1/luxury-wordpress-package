{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/apartments/",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Luxury Apart Hotel Group (demo)",
        "permalink_structure": "/%postname%/"
      }
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/halubouski1/luxury-wordpress-package/8a59f21f1bc941992abbf5cedab8eb00b2f4c432/catalog-v1.1/luxury-editorial-plugin.zip"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/halubouski1/luxury-wordpress-package/8a59f21f1bc941992abbf5cedab8eb00b2f4c432/catalog-v1.1/luxury-apart-hotel-theme.zip"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; wp_set_current_user(1); lux_import_starter(true); lux_import_catalog(); flush_rewrite_rules();"
    }
  ]
}